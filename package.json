{
  "name": "milkdown-plugin-bible",
  "version": "0.1.0",
  "description": "Bible references for Milkdown: finds references as you write, previews the passage and inserts it as a quote.",
  "keywords": [
    "milkdown",
    "milkdown plugin",
    "crepe",
    "prosemirror",
    "bible",
    "scripture",
    "markdown"
  ],
  "license": "MIT",
  "author": "Tim Stewart (https://github.com/TimStewartJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimStewartJ/milkdown-plugin-bible.git"
  },
  "homepage": "https://github.com/TimStewartJ/milkdown-plugin-bible#readme",
  "bugs": "https://github.com/TimStewartJ/milkdown-plugin-bible/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixtures.ts"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints style.css",
    "test:consumer": "npm run build && node scripts/test-consumer.mjs",
    "generate:versification": "node scripts/generate-versification.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@milkdown/kit": "^7.22.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "jsdom": "^29.0.2",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
